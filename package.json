{
  "name": "safestripe",
  "version": "0.3.0",
  "description": "Durable Stripe operations and webhook processing for Node.js, Express and Next.js",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "import": "./dist/adapters/next.js"
    },
    "./migrations": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    },
    "./storage/sqlite": {
      "types": "./dist/storage/sqlite.d.ts",
      "import": "./dist/storage/sqlite.js"
    },
    "./storage/postgres": {
      "types": "./dist/storage/postgres.d.ts",
      "import": "./dist/storage/postgres.js"
    },
    "./storage/mongodb": {
      "types": "./dist/storage/mongodb.d.ts",
      "import": "./dist/storage/mongodb.js"
    },
    "./storage/firestore": {
      "types": "./dist/storage/firestore.d.ts",
      "import": "./dist/storage/firestore.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "docs",
    "benchmarks/README.md",
    "benchmarks/results/*.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "VERIFICATION.md",
    "maintainer/README.md",
    "examples/local",
    "examples/shared",
    "examples/express",
    "examples/nextjs/app",
    "examples/nextjs/next.config.ts",
    "examples/firestore",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/sync-migrations.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "dev:express": "node --env-file=.env --import tsx examples/local/server.ts",
    "dev:next": "node --env-file=.env node_modules/next/dist/bin/next dev examples/nextjs --hostname 127.0.0.1 --webpack",
    "build:next": "next build examples/nextjs --webpack",
    "worker": "node --env-file=.env --import tsx examples/local/worker.ts",
    "test:stripe": "node --env-file=.env --import tsx scripts/stripe-smoke.ts",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs && node scripts/check-snippets.mjs && node scripts/check-docs-ui.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "licenses": "node scripts/licenses.mjs",
    "release:check": "npm run format:check && npm run check && npm run build:next && npm run docs:build && npm run docs:check && npm run licenses && npm run test:package && npm run site:build && npm run site:check",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"examples/**/*.tsx\" \"scripts/*.{ts,mjs,js,css}\" \"*.json\" \".github/workflows/*.yml\" \"benchmarks/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"examples/**/*.tsx\" \"scripts/*.{ts,mjs,js,css}\" \"*.json\" \".github/workflows/*.yml\" \"benchmarks/**/*.ts\"",
    "dev:express:legacy": "node --env-file=.env --import tsx examples/express/server.ts",
    "worker:legacy": "node --env-file=.env --import tsx examples/worker.ts",
    "site:build": "npm run docs:build && node scripts/build-site.mjs",
    "site:preview": "node scripts/preview-site.mjs",
    "site:check": "node scripts/check-site.mjs",
    "test:chaos": "node --import tsx --test --test-concurrency=1 tests/chaos/*.test.ts",
    "benchmark": "node --import tsx benchmarks/run.ts",
    "test:stripe:e2e": "node --env-file-if-exists=.env --import tsx scripts/stripe-e2e.ts",
    "test:stripe:lifecycle": "node --env-file-if-exists=.env --import tsx scripts/stripe-lifecycle.ts",
    "test:registry": "node scripts/check-registry.mjs"
  },
  "dependencies": {
    "@types/express": "^5.0.3",
    "stripe": "23.0.0",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@google-cloud/firestore": ">=9 <10",
    "@stripe/react-stripe-js": "6.12.0",
    "@stripe/stripe-js": "9.17.0",
    "express": ">=5 <6",
    "express-rate-limit": ">=8 <9",
    "mongodb": ">=7 <8",
    "pg": "^8.16.3",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "@google-cloud/firestore": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "@stripe/react-stripe-js": {
      "optional": true
    },
    "@stripe/stripe-js": {
      "optional": true
    },
    "express-rate-limit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@google-cloud/firestore": "9.2.0",
    "@stripe/cli": "1.53.0",
    "@stripe/react-stripe-js": "6.12.0",
    "@stripe/stripe-js": "9.17.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "linkedom": "0.18.13",
    "marked": "18.0.14",
    "mongodb": "7.6.0",
    "next": "16.3.8",
    "pg": "^8.16.3",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "4.4.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "stripe",
    "payments",
    "billing",
    "webhooks",
    "idempotency",
    "express",
    "nextjs",
    "postgresql",
    "mongodb",
    "firestore",
    "sqlite"
  ],
  "bin": {
    "safestripe": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Israel-oduguwa/SafeStripe.git"
  },
  "homepage": "https://israel-oduguwa.github.io/SafeStripe/",
  "bugs": {
    "url": "https://github.com/Israel-oduguwa/SafeStripe/issues"
  }
}
