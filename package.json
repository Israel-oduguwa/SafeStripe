{
  "name": "@safestripe/core",
  "version": "0.1.0",
  "description": "Durable Stripe operations and webhook processing for Node.js, Express and Next.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "import": "./dist/adapters/next.js"
    },
    "./migrations": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "VERIFICATION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "dev:express": "node --env-file=.env --import tsx examples/express/server.ts",
    "dev:next": "node --env-file=.env node_modules/next/dist/bin/next dev examples/nextjs --hostname 127.0.0.1 --webpack",
    "build:next": "next build examples/nextjs --webpack",
    "worker": "node --env-file=.env --import tsx examples/worker.ts",
    "test:stripe": "node --env-file=.env --import tsx scripts/stripe-smoke.ts",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs && node scripts/check-snippets.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "licenses": "node scripts/licenses.mjs",
    "release:check": "npm run format:check && npm run check && npm run build:next && npm run docs:build && npm run docs:check && npm run licenses && npm run test:package",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"examples/**/*.tsx\" \"scripts/*.{ts,mjs,js,css}\" \"*.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"examples/**/*.tsx\" \"scripts/*.{ts,mjs,js,css}\" \"*.json\" \".github/workflows/*.yml\""
  },
  "dependencies": {
    "@types/express": "^5.0.3",
    "pg": "^8.16.3",
    "stripe": "22.6.2",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "express": ">=5 <6"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "express": "5.2.1",
    "marked": "18.0.14",
    "next": "16.3.6",
    "prettier": "3.9.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "stripe",
    "payments",
    "billing",
    "webhooks",
    "idempotency",
    "express",
    "nextjs",
    "postgresql"
  ],
  "bin": {
    "safestripe": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Israel-oduguwa/SafeStripe.git"
  },
  "homepage": "https://github.com/Israel-oduguwa/SafeStripe#readme",
  "bugs": {
    "url": "https://github.com/Israel-oduguwa/SafeStripe/issues"
  }
}
