# Sandbox only. Keep this file private after copying it to .env.
STRIPE_SECRET_KEY=
# Printed by stripe listen. Different from your secret API key.
STRIPE_WEBHOOK_SECRET=
# Optional: discovered from the secret key unless its permissions prevent account reads.
STRIPE_ACCOUNT_ID=
# Needed only for the embedded Next.js payment form, not hosted Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
BILLING_DATABASE=sqlite
SQLITE_PATH=./.data/billing.sqlite
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DEMO_TOKEN=
# Create a sandbox customer and a one-time Price in Stripe.
DEMO_CUSTOMER_ID=
DEMO_PRICE_ID=
# Choose a NEW order ID for a new purchase or when switching hosted/custom UI.
DEMO_ORDER_ID=demo-order-001
# Only fill these when selecting a hosted database instead of SQLite.
DATABASE_URL=
MONGODB_URI=
MONGODB_DATABASE=safestripe_sandbox
GOOGLE_CLOUD_PROJECT=
